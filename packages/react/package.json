{
  "name": "@tensorpass/aiconnect-react",
  "version": "0.1.1",
  "description": "React provider picker and chat hook for AI Connect.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "license": "Apache-2.0",
  "homepage": "https://tensorpass.app/docs",
  "bugs": {
    "email": "hello@tensorpass.app"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "default": "./dist/launcher.js"
    },
    "./styles.css": "./dist/styles.css",
    "./launchers.css": "./dist/launchers.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b && esbuild src/styles.css --bundle --outfile=dist/styles.css --log-level=warning && cp src/modules/styles/launchers.css dist/launchers.css"
  },
  "dependencies": {
    "@tensorpass/aiconnect": "0.1.1",
    "@tensorpass/aiconnect-design": "0.1.1"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tensorpass/aiconnect.git",
    "directory": "packages/react"
  }
}
