{
  "name": "@tensorpass/aiconnect-design",
  "version": "0.1.0",
  "description": "The design tokens, the TensorPass mark, the providers' marks, key card colours and room colours shared by the AI Connect connect window, the AI Wallet extension and the website.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "license": "Apache-2.0",
  "homepage": "https://tensorpass.app/docs",
  "bugs": {
    "email": "hello@tensorpass.app"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b",
    "brand": "node scripts/exportBrand.ts"
  },
  "exports": {
    "./tokens.css": "./tokens.css",
    "./card-tints": {
      "types": "./dist/cardTints.d.ts",
      "default": "./dist/cardTints.js"
    },
    "./room-color": {
      "types": "./dist/roomColor.d.ts",
      "default": "./dist/roomColor.js"
    },
    "./brand-mark": {
      "types": "./dist/brandMark.d.ts",
      "default": "./dist/brandMark.js"
    },
    "./provider-marks": {
      "types": "./dist/providerMarks.d.ts",
      "default": "./dist/providerMarks.js"
    }
  },
  "files": [
    "tokens.css",
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "devDependencies": {
    "@fontsource/reddit-sans": "^5.3.0",
    "opentype.js": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
