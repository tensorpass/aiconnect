{
  "name": "@tensorpass/aiconnect",
  "version": "0.1.5",
  "description": "Headless SDK: connect a visitor's own AI account and run the site's tools with it.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "homepage": "https://tensorpass.app/docs",
  "bugs": {
    "email": "hello@tensorpass.app"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guards": {
      "types": "./dist/guards/index.d.ts",
      "default": "./dist/guards/index.js"
    },
    "./callback": {
      "types": "./dist/callback.d.ts",
      "default": "./dist/callback.js"
    }
  },
  "bin": {
    "aiconnect": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo tsconfig.cli.tsbuildinfo && tsc -b tsconfig.json tsconfig.cli.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai": "^4.0.111",
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "@langchain/core": "^1.3.5",
    "@langchain/openai": "^1.8.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "ai": "^7.0.165",
    "openai": "^7.53.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tensorpass/aiconnect.git",
    "directory": "packages/core"
  }
}
