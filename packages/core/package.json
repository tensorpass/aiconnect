{
  "name": "@tensorpass/aiconnect",
  "version": "0.1.0",
  "description": "Headless SDK: connect a visitor's own AI account and run the site's tools with it.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "exports": {
