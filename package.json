{
  "name": "aiwallet-sdk",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Let visitors connect their own AI account to any website: one click, their plan or credits, no inference bill for the site.",
  "type": "module",
  "workspaces": [
    "packages/design",
    "packages/core",
    "packages/react",
    "packages/elements",
    "apps/demo"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/core packages/core/tsconfig.cli.json packages/react && tsc -p packages/elements && tsc -p apps/demo",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "e2e": "npm run e2e -w @tensorpass/demo",
    "lint": "eslint .",
    "dev": "npm run dev -w @tensorpass/demo",
    "release:check": "node scripts/check-release.mjs",
    "release:smoke": "node scripts/check-package-install.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
